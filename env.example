# Copiar a .env y completar valores locales (no commitear .env).

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# JWT (obligatorio en producción)
JWT_SECRET=
# Opcional: caducidad del token en segundos (por defecto 86400)
# JWT_EXPIRES_IN=86400

# Certificados (opcional)
# CERT_IMAGE_DEFAULT=
# CERT_IMAGE_URL=
